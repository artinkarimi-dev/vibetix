{
  "name": "vibetix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:browsers": "QA_ALL_BROWSERS=true playwright test",
    "images:optimize": "node scripts/optimize-images.mjs",
    "format:check": "prettier --check src tests scripts backend/src backend/tests backend/prisma/seed.ts packages/shared *.ts *.json backend/*.json",
    "images:audit": "node scripts/audit-assets.mjs",
    "performance:measure": "node scripts/measure-performance.mjs",
    "build:audit": "node scripts/audit-build.mjs",
    "test:payment-failure": "node scripts/check-payment-failure.mjs",
    "backend:dev": "node --env-file=.env.local --import tsx backend/src/server.ts",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:start": "node backend/dist/backend/src/server.js",
    "backend:test": "node scripts/verify-production.mjs",
    "worker": "node --env-file=.env.local --import tsx backend/src/worker.ts",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "node scripts/ops/migrate.mjs",
    "db:seed": "tsx backend/prisma/seed.ts",
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "node scripts/local-up.mjs",
    "test:fullstack": "tsx scripts/fullstack-qa.ts",
    "backend:typecheck": "tsc -p backend/tsconfig.tests.json",
    "security:check": "node scripts/check-secrets.mjs && node scripts/security-check.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "test:preproduction": "node --import tsx scripts/preproduction-validation.mjs",
    "db:permissions": "node scripts/ops/database-security.mjs",
    "staging:init": "node scripts/staging.mjs init",
    "staging:up": "node scripts/staging.mjs up",
    "staging:verify": "node scripts/staging.mjs verify",
    "staging:down": "node scripts/staging.mjs down",
    "db:preflight": "node scripts/ops/preflight.mjs",
    "db:integrity": "node scripts/ops/integrity.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "lint": "eslint . --max-warnings=0",
    "demo:reset": "node --import tsx scripts/demo-reset.mjs",
    "test:portfolio": "playwright test -c playwright.portfolio.config.ts",
    "demo": "node showcase/server.mjs",
    "demo:test": "node --test showcase/*.test.mjs",
    "stage1:up": "node scripts/stage1-up.mjs up",
    "stage1:down": "node scripts/stage1-up.mjs down",
    "stage1:status": "node scripts/stage1-up.mjs status",
    "stage1:logs": "node scripts/stage1-up.mjs logs",
    "stage1:verify": "node scripts/stage1-smoke.mjs",
    "stage1:test": "node --test scripts/tests/stage1-smoke.test.mjs",
    "stage2:test": "node --test scripts/tests/stage1-smoke.test.mjs scripts/tests/stage2-core.test.mjs showcase/*.test.mjs",
    "stage2:verify": "node scripts/stage2-verify.mjs",
    "stage2:all": "node scripts/stage2-all.mjs",
    "stage3:studio": "node scripts/stage3-studio.mjs",
    "stage3:race": "node scripts/stage3-runner.mjs",
    "stage3:test": "node --test scripts/tests/stage1-smoke.test.mjs scripts/tests/stage2-core.test.mjs scripts/tests/stage3-core.test.mjs scripts/tests/stage3-studio.test.mjs showcase/*.test.mjs",
    "stage3:all": "node scripts/stage3-all.mjs",
    "stage4:check": "node scripts/stage4/release-gate.mjs",
    "stage4:verify": "node scripts/stage4/release-gate.mjs --live",
    "stage4:deploy-check": "node scripts/stage4/deploy-preflight.mjs",
    "stage4:nginx": "node scripts/stage4/render-nginx.mjs",
    "stage4:package-check": "node scripts/stage4/verify-package.mjs",
    "stage4:format": "prettier --write scripts/stage4 scripts/tests/stage4-policy.test.mjs package.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "ioredis": "6.0.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.25.0"
}
